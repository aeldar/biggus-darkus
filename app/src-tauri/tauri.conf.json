{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biggus Darkus",
  "version": "0.1.0",
  "identifier": "dev.biggusdarkus.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [{ "title": "Biggus Darkus", "width": 900, "height": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Elite Dangerous journal to Biggus Darkus board",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "desktopTemplate": "bd-app.desktop"
      }
    }
  }
}
